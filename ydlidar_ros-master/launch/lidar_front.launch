<!-- *********************************************************************************************************** -->

<!-- New version -->
<launch>
  <node name="ydlidar_front" pkg="ydlidar_ros" type="ydlidar_node" output="screen" respawn="false">
    <param name="port"             type="string" value="/dev/ydlidar_front"/>
    <param name="baudrate"         type="int"    value="512000"/>
    <param name="frame_id"         type="string" value="laser_front"/>
    <param name="resolution_fixed" type="bool"   value="true"/>
    <param name="auto_reconnect"   type="bool"   value="true"/>
    <param name="reversion"        type="bool"   value="true"/>
    <param name="angle_min"        type="double" value="-30"/>
    <param name="angle_max"        type="double" value="90"/>
    <param name="range_min"        type="double" value="0.1"/>
    <param name="range_max"        type="double" value="50"/>
    <param name="ignore_array"     type="string" value=""/>
    <param name="frequency"        type="double" value="10"/>
    <param name="isTOFLidar"       type="bool"   value="true"/>

    <remap from="scan" to="laser_front" />
  </node>
</launch>


