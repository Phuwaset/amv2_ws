<launch>
  <!-- =================================================================== -->
  <!-- 0. Parameters & Arguments                                           -->
  <!-- =================================================================== -->
  <arg name="map_file" default="$(find amv_mapping)/map/map_office_202608/office_test_v2.yaml"/>
  <arg name="open_rviz" default="false"/>

  <!-- =================================================================== -->
  <!-- 1. Map Server & AMCL Localization                                   -->
  <!-- =================================================================== -->
  <node pkg="map_server" name="map_server" type="map_server" args="$(arg map_file)"/>

  <include file="$(find amv_virtual_track)/launch/amcl.launch">
    <arg name="initial_pose_x" value="0.0"/>
    <arg name="initial_pose_y" value="0.0"/>
    <arg name="initial_pose_a" value="$(eval 0.0 * 3.14159265359 / 180.0)"/>
  </include>

  <!-- =================================================================== -->
  <!-- 2. โมดูลระบบ Virtual Track                                          -->
  <!-- =================================================================== -->
  
  <!-- 2.1 แสดงป้ายชื่อสถานี + ลูกศรทิศทางจอด -->
  <node pkg="amv_virtual_track" type="station_marker_node.py" name="station_marker_node" output="screen">
    <param name="csv_path" value="$(find amv_virtual_track)/config/station_list.csv" />
    <param name="frame_id" value="map" />
  </node>

  <!-- 2.2 บันทึก Waypoint เมื่อคลิก 2D Nav Goal บน RViz -->
  <node pkg="amv_virtual_track" type="waypoint_recorder_node.py" name="waypoint_recorder_node" output="screen">
    <param name="csv_path" value="$(find amv_virtual_track)/config/waypoint_follower_list.csv" />
    <param name="yaml_path" value="$(find amv_virtual_track)/config/waypoints.yaml" />
    <param name="frame_id" value="map" />
  </node>

  <!-- 2.3 คำนวณและสร้างแนวรางเสมือนความละเอียดสูง (/planned_path) -->
  <node pkg="amv_virtual_track" type="path_planner_node.py" name="path_planner_node" output="screen">
    <param name="station_csv"  value="$(find amv_virtual_track)/config/station_list.csv" />
    <param name="waypoint_csv" value="$(find amv_virtual_track)/config/waypoint_follower_list.csv" />
    <param name="frame_id"     value="map" />
    <param name="step_size"    value="0.05" />
  </node>

  <!-- 2.4 Pure Pursuit Controller ขับเคลื่อนหุ่นยนต์จริงตามราง -->
  <node pkg="amv_virtual_track" type="waypoint_controller_node.py" name="waypoint_controller_node" output="screen">
    <param name="csv_path"          value="$(find amv_virtual_track)/config/station_list.csv" />
    <param name="waypoint_csv"     value="$(find amv_virtual_track)/config/waypoint_follower_list.csv" />
    <param name="frame_id"          value="map" />
    <param name="base_frame"        value="base_footprint" />
    
    <!-- จูนการวิ่งทางตรงและแก้อาการส่ายตอนออกตัว -->
    <param name="lookahead_dist"    value="0.50" />   <!-- เพิ่มระยะมองไกลขึ้น ไม่ให้หัวรถปาดเข้าหาเส้นแรง -->
    <param name="max_lin_vel"       value="0.25" />   <!-- ความเร็ววิ่งทางตรง (m/s) -->
    <param name="min_lin_vel"       value="0.05" />   <!-- ความเร็วคลานเข้าจอด (Creep Speed)[cite: 1, 3] -->
    <param name="max_ang_vel"       value="0.30" />   <!-- บีบความเร็วเลี้ยวไม่ให้ล้อสะบัดแรง[cite: 1, 3] -->
    <param name="max_accel"         value="0.10" />   <!-- ลดอัตราเร่งตอนออกตัว ออกตัวนุ่มนวล[cite: 1, 3] -->
    <param name="max_decel"         value="0.20" />   <!-- อัตราเบรกชะลอให้นุ่มขึ้น[cite: 1, 3] -->

    <!-- จังหวะการเทียบจอดและหมุน 180 องศา -->
    <param name="decel_dist_station" value="0.30" />  <!-- เริ่มผ่อนคันเร่งก่อนถึงสถานี 0.30 ม.[cite: 1, 3] -->
    <param name="station_dist_tol"  value="0.15" />   <!-- รัศมีหยุดตัดความเร็วเป็นศูนย์[cite: 1, 3] -->
    <param name="yaw_tol"           value="0.03" />   <!-- ความละเอียดมุมหมุน (~1.7 องศา)[cite: 1, 3] -->

    <!-- การออกตัวจากสถานี: ตรงตามหัวรถ 0.20 m/s ไม่คำนวณPP จนครบ 0.30 ม. แล้วค่อยเข้า Pure Pursuit -->
    <param name="depart_v"          value="0.20" />
    <param name="depart_dist"       value="0.50" />
    <param name="station_depart_tol" value="0.60" />  <!-- รัศมีที่ถือว่า "อยู่ที่สถานี" ถึงจะต้อง DEPART -->

    <!-- การเทียบจอดแบบจุดเช็ค (คำนวณจาก x/y/yaw ของ CSV: จุดเช็ค = สถานี - 1.0ม. ตามแนว yaw) -->
    <param name="entry_check_dist"   value="0.50" /> <!-- ระยะจุดเช็คล่วงหน้า (m) -->
    <param name="entry_trigger_dist" value="1.20" /> <!-- เริ่มสลับเป้าไปจุดเช็คเมื่อใกล้สถานี (m) -->
    <param name="entry_hold_dist"    value="0.15" /> <!-- รัศมีนับว่าถึงจุดเช็ค (m) -->
    <param name="entry_approach_v"   value="0.15" /> <!-- ความเร็วช่วงลัดเข้าจุดเช็ค (m/s) -->
    <param name="entry_linear_v"     value="0.10" /> <!-- ความเร็วเชิงเส้นคงที่: หันหน้าถูกแล้ว (m/s) -->
    <param name="dock_align_tol"     value="0.07" /> <!-- ระยะหยุดเทียบจากศูนย์กลางสถานี (m) -->

    <!-- ส่งความเร็วเข้า /nav_vel เพื่อให้ผ่านระบบ twist_mux ของ AMV2 -->
    <remap from="/cmd_vel" to="/nav_vel" />
    <remap from="/scan" to="/scan" />
  </node>

  <!-- 2.5 Visualizer แสดงกรอบ Zone 1 บน RViz -->
  <!-- <node pkg="amv_virtual_track" type="safety_zone_visualizer.py" name="safety_zone_visualizer" output="screen">
      <param name="frame_id" value="base_link" />
      <param name="x_min"    value="0.43" />
      <param name="x_max"    value="0.78" />
      <param name="y_min"    value="-0.28" />
      <param name="y_max"    value="0.28" />
  </node> -->
</launch>