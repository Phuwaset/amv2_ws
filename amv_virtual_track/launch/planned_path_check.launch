<?xml version="1.0"?>
<launch>
  <!-- ตัวช่วยตรวจ /planned_path แบบ OFFLINE (หุ่นไม่วิ่ง):
       - static TF map->base_footprint ที่ตำแหน่งจำลอง
       - path_planner_node (อ่าน office CSV)
       - planned_path_visualizer (วาด graph + เส้นทางบน RViz)
       Trigger: rostopic pub -1 /amv/command/goto_station std_msgs/String "data: 'Line1'"
       ดูผล: rostopic echo -n1 /planned_path / /planned_path_markers -->
  <arg name="start_x" default="-3.1004676818847656"/>
  <arg name="start_y" default="-0.54880690574646"/>
  <arg name="start_yaw" default="0.0"/>
  <arg name="connect_dist" default="5.0"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="check_tf"
        args="$(arg start_x) $(arg start_y) 0 $(arg start_yaw) 0 0 map base_footprint"/>

  <node pkg="amv_virtual_track" type="path_planner_node.py" name="path_planner_node" output="screen">
    <param name="max_connect_dist" value="$(arg connect_dist)"/>
  </node>

  <node pkg="amv_virtual_track" type="planned_path_visualizer.py" name="planned_path_visualizer" output="screen">
    <param name="max_connect_dist" value="$(arg connect_dist)"/>
  </node>
</launch>
