<?xml version="1.0"?>
<launch>
  <!-- Navigation service (clean, no recorder nodes):
       station_service (for /go_station) + path_planner_node (for /planned_path) only.
       Recorders (station_plotting_test / waypoint_recorder_test) ใช้เฉพาะโหมด amv_recording -->

  <include file="$(find amv_service)/launch/station_service.launch" />

  <node pkg="amv_virtual_track" type="path_planner_node.py" name="path_planner_node" output="screen">
    <param name="station_csv"  value="$(find amv_service)/station/station_list.csv" />
    <param name="waypoint_csv" value="$(find amv_service)/station/waypoint_follower_list.csv" />
    <param name="frame_id"     value="map" />
    <param name="step_size"    value="0.05" />
  </node>

</launch>