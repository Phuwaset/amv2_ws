<?xml version="1.0"?>
<robot name="origins">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>      
      	<geometry>
          <box size="0.770 0.510 0.160"/>
      	</geometry>      
	      <origin xyz="0 0 0.045" rpy="0 0 0" />	
	      <material name="orange1">
          <color rgba="1 0.6 0 1"/>
      	</material>
    </visual>
  </link> 

  <joint name="basefootprint_to_baselink" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="middle_cover">
    <visual>
      <geometry>
        <box size="0.6 0.45 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="orange2">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_middle" type="fixed">
    <parent link="base_link"/>
    <child link="middle_cover"/>
    <origin xyz="0 0 0.170"/>
  </joint>

  <link name="top_cover">
    <visual>
      <geometry>
        <box size="0.75 0.49 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black1">
        <color rgba="0.3 0.3 0.3 0.98"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_top" type="fixed">
    <parent link="base_link"/>
    <child link="top_cover"/>
    <origin xyz="0 0 0.190"/>
  </joint>


  <link name="imu_link"/>
  <joint name="baselink_to_imulink" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!--<origin xyz="0.007 0 0.125" rpy="3.1416 0 3.1416"/>-->  <!--imu m0-->
    <origin xyz="0.007 0 0.125" rpy="0 0 0"/> <!--imu df-->
  </joint>

  <link name="laser_front"/>
  <joint name="baselink_to_laserfront" type="fixed">
    <parent link="base_link"/>
    <child link="laser_front"/>
    <origin xyz="0.345 0 0.150" rpy="0 0 -0.5236"/>
  </joint>

  <link name="laser_back"/>
  <joint name="baselink_to_laserback" type="fixed">
    <parent link="base_link"/>
    <child link="laser_back"/>
    <origin xyz="-0.345 0 0.150" rpy="0 0 3.14159"/> 
  </joint>

  <link name="laser_link"/>
  <joint name="baselink_to_laserlink" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.0 0 0.150" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <joint name="laserlink_to_cameralink" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.382 0.02 0.095" rpy="0 0 0"/>
  </joint>   

</robot>
