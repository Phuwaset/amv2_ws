<?xml version="1.0"?>
<launch>

    <node type="joy_node" pkg="joy" name="joy">
            <param name="dev" value="/dev/input/js0"/>
            <param name="autorepeat_rate" value="1"/>
            <param name="deadzone" value="0.10"/>
    </node>

    <node type="teleop_node" pkg="teleop_twist_joy" name="joy_to_twist">
	<remap from="cmd_vel" to="joy_vel_raw"/>
        <param name="scale_linear" value="0.7"/>
        <param name="scale_angular" value="0.6"/>
        <param name="enable_button" value="4"/>
        <param name="enable_turbo_button" value="5"/>
        <param name="scale_linear_turbo" value="0.5"/>
        <param name="scale_angular_turbo" value="0.8"/>
        <param name="deadzone" value="0.1"/>
    </node>

    <node type="joy_vel_filter.py" pkg="amv_connect" name="joy_vel_filter" output="screen">
        <param name="filter_tau" value="0.05"/>
        <param name="max_linear_accel" value="2.0"/>
        <param name="max_angular_accel" value="4.0"/>
        <param name="deadband_linear" value="0.01"/>
        <param name="deadband_angular" value="0.02"/>
        <param name="input_timeout" value="1.5"/>
    </node>

</launch>