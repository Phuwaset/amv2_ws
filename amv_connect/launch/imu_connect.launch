<?xml version="1.0"?>
  <!-- 
  <arg name="razor_config_file" default="$(find razor_imu_9dof)/config/my_razor.yaml"/>
  <node pkg="razor_imu_9dof" type="imu_node.py" name="imu_node" output="screen">
    <rosparam file="$(arg razor_config_file)" command="load"/>
  </node>

  <node pkg="tf" type="static_transform_publisher" name="base_imu_to_base_link" args="0 0 0 0 0 0 /base_imu_link /base_link 1"/>
   <node pkg="tf" type="static_transform_publisher" name="base_foot_to_base_imu_link" args="0 0 0 0 0 0 /base_footprint /base_imu_link 1"/>

   -->
   <!-- -*- mode: XML -*- -->
<launch>

  <!-- Select the driver type (currently only "factory_firmware" is supported) -->
  <arg name="driver_type" default="factory_firmware" />

  <!-- Optionally set node name -->
  <arg name="node_name" default="imu_driver" />

  <!-- Optional debugging arguments -->
  <arg name="debug" default="false" /> <!-- launch in GDB -->
  <arg name="output" default="screen" /> <!-- output to "screen" or "log" -->

  <!-- launch-configured driver parameters -->
  <arg name="set_logger_level_debug" default="false" />
  <arg name="port" default="/dev/imu_m0" />

  <!-- Optionally provide a path to specify additional parameters in a rosparam yaml file,
       which will be loaded into nodes' private namespace  -->
  <arg name="rosparam_file" default="$(find razor_imu_m0_driver)/param/$(arg driver_type).yaml" />

  <!-- driver node include -->
  <include file="$(find razor_imu_m0_driver)/launch/includes/$(arg driver_type)_driver_node.launch.xml">
    <arg name="node_name" value="$(arg node_name)" />
    <arg name="debug" value="$(arg debug)" />
    <arg name="output" value="$(arg output)" />
    <arg name="set_logger_level_debug" value="$(arg set_logger_level_debug)" />
    <arg name="port" value="$(arg port)" />
    <arg name="rosparam_file" value="$(arg rosparam_file)" />
  </include>
   <!--node pkg="tf" type="static_transform_publisher" name="base_imu_to_base_link" args="0 0 0 0 0 0 /imu_link /base_link 1"/-->
   <!--node pkg="tf" type="static_transform_publisher" name="base_foot_to_base_imu_link" args="0 0 0 0 0 0 /base_footprint /imu_link 1"/-->
</launch>

